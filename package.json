{
  "name": "minecraft-core",
  "private": true,
  "version": "26.6.1",
  "description": "Minecraft Core",
  "author": "zXord",
  "main": "electron/startup-entry.cjs",
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26"
  },
  "scripts": {
    "dev": "concurrently -k --success=first \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite dev",
    "dev:electron": "node scripts/start-dev-electron.cjs",
    "test": "node --test --test-concurrency=4",
    "test:modpacks": "node --test --test-concurrency=4 tests/modpacks/*.test.cjs",
    "test:failure-matrix": "node --test tests/modpacks/lifecycle-failure-matrix.test.cjs",
    "test:e2e:modpacks": "playwright test tests/e2e/modpack-setup.spec.js tests/e2e/modpack-lifecycle.spec.js tests/e2e/modpack-recovery-accessibility.spec.js tests/e2e/startup-auto-start.spec.js --workers=1",
    "test:e2e:modpack-launch-reconciliation": "playwright test tests/e2e/modpack-launch-reconciliation.spec.js --workers=1",
    "test:e2e:dev-startup": "playwright test tests/e2e/dev-startup-render.spec.js --workers=1",
    "test:e2e:ipc-handoff": "playwright test tests/e2e/main-process-ipc-handoff.spec.js --workers=1",
    "test:e2e:disposable-client-join": "playwright test tests/e2e/disposable-client-join.spec.js --workers=1",
    "test:e2e:disposable-client-join-continuation": "playwright test tests/e2e/disposable-client-join-continuation.spec.js --workers=1",
    "test:e2e:real-github-releases": "playwright test tests/e2e/real-github-releases.spec.js --workers=1",
    "test:e2e:real-tfg": "playwright test tests/e2e/real-terrafirmagreg-inspection.spec.js --workers=1",
    "test:e2e:real-github-release-monitor": "playwright test tests/e2e/real-github-release-monitor.spec.js --workers=1",
    "smoke:packaged:modpacks": "node scripts/run-modpack-packaged-smoke.mjs",
    "build": "vite build && node scripts/post-build.mjs",
    "build:icons": "node scripts/generate-icon.cjs",
    "verify:archive-runtime": "node scripts/verify-archive-runtime.cjs",
    "verify:packaged-archive": "node scripts/verify-packaged-archive.cjs",
    "start": "electron .",
    "prod": "npm run build && npm run start",
    "pack": "npm run build && npm run build:icons && npm run verify:archive-runtime && electron-builder --dir",
    "dist": "npm run build && npm run build:icons && npm run verify:archive-runtime && electron-builder",
    "release": "npm run build && npm run build:icons && npm run verify:archive-runtime && electron-builder --publish=always"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@eslint/js": "^9.28.0",
    "@playwright/test": "1.62.1",
    "@typescript-eslint/eslint-plugin": "^8.34.0",
    "@typescript-eslint/parser": "^8.34.0",
    "concurrently": "^9.1.2",
    "electron": "42.10.1",
    "electron-builder": "^26.0.12",
    "eslint": "^9.31.0",
    "eslint-plugin-svelte": "^3.9.2",
    "globals": "^16.2.0",
    "png-to-ico": "^3.0.1",
    "rcedit": "^4.0.1",
    "sharp": "^0.33.5",
    "typescript": "^5.8.3",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.1.0",
    "@xmcl/installer": "^6.1.0",
    "@xmcl/user": "^4.2.0",
    "adm-zip": "^0.5.16",
    "ajv": "8.20.0",
    "archiver": "^7.0.0",
    "axios": "^1.6.2",
    "cors": "^2.8.5",
    "electron-log": "^5.4.3",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.6.2",
    "express": "^4.18.2",
    "fs-extra": "^11.3.0",
    "ipaddr.js": "2.4.0",
    "lucide-svelte": "^0.511.0",
    "minecraft-data": "^3.89.0",
    "msmc": "^4.1.0",
    "nbt": "^0.8.1",
    "pidusage": "^4.0.0",
    "prismarine-nbt": "^2.7.0",
    "progress-stream": "^2.0.0",
    "rimraf": "^5.0.0",
    "selfsigned": "^5.2.0",
    "svelte": "^5.36.8",
    "svelte-sonner": "^1.0.1",
    "undici": "7.28.0",
    "uuid": "^11.1.1",
    "yauzl": "3.4.0"
  },
  "overrides": {
    "undici": "7.28.0",
    "uuid": "$uuid",
    "yauzl": "3.4.0"
  },
  "build": {
    "appId": "com.minecraft-core.app",
    "productName": "Minecraft Core",
    "directories": {
      "output": "dist",
      "buildResources": "build-resources"
    },
    "extraMetadata": {
      "name": "minecraft-core",
      "productName": "Minecraft Core"
    },
    "files": [
      "dist/**/*",
      "!dist/win-unpacked",
      "!dist/win-unpacked/**/*",
      "!dist/Minecraft-Core-Setup-*.exe",
      "!dist/Minecraft-Core-Setup-*.exe.blockmap",
      "!dist/latest.yml",
      "!dist/builder-*.yml",
      "electron/**/*",
      "package.json",
      "icon.png",
      "build-resources/icon.ico",
      "config/dev-config.cjs"
    ],
    "extraResources": [
      {
        "from": "vendor/7zip/${arch}",
        "to": "archive/7zip",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "vendor/archive-worker/${arch}",
        "to": "archive/worker",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "third-party/7zip",
        "to": "archive/licenses",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build-resources/archive-runtime",
        "to": "archive/manifests",
        "filter": [
          "*.json"
        ]
      }
    ],
    "copyright": "Copyright © 2025 zXord",
    "win": {
      "target": "nsis",
      "requestedExecutionLevel": "asInvoker",
      "verifyUpdateCodeSignature": false,
      "executableName": "Minecraft Core",
      "icon": "build-resources/icon.ico",
      "signAndEditExecutable": false
    },
    "beforePack": "scripts/verify-packaged-archive.cjs",
    "afterPack": "scripts/afterPack.cjs",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "include": "build-resources/uninstaller.nsh",
      "warningsAsErrors": false,
      "artifactName": "Minecraft-Core-Setup-${version}.exe",
      "displayLanguageSelector": false,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Minecraft Core",
      "uninstallDisplayName": "Minecraft Core",
      "installerIcon": "build-resources/icon.ico",
      "uninstallerIcon": "build-resources/icon.ico",
      "differentialPackage": true
    },
    "publish": {
      "provider": "github",
      "owner": "zXord",
      "repo": "Minecraft-Core"
    }
  }
}
